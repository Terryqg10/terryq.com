{
  "name": "terryq.com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "capture:pages": "playwright test -c playwright.visual.config.ts",
    "icons": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-icons.ts",
    "tokens": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-tokens.ts",
    "lhci": "lhci autorun",
    "size": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-js-size.ts",
    "screenshots": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/capture-screenshots.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.53.0",
    "next": "16.4.0",
    "next-intl": "~4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  }
}
